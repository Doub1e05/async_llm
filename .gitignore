# pycache
__pycache__/
*.py[cod]
*$py.class

# installed packages
*.dist-info/
*.egg-info/

# json files
*.json
*.jsonl

# profiling data
*.nsys-rep
*.ncu-rep

# binaries
build/
dist/
*.tar.gz

# virtual environment
.venv/
venv/
env/

# clangd config
.clangd

# .vscode
.vscode/
.coverage

# local Doom experiment
/scripts/doom_basic/deadly_corridor_probe.ipynb
/scripts/doom_basic/output/
/_vizdoom.ini
/_vizdoom/

# Robot runtime and experiment logs
/robot_sim/.runtime/
/robot_sim/results/


# Keep source configuration despite the upstream blanket JSON ignore.
!/rover_urdf/*.json
!/mujoco_scene/*.json
!/robot_sim/direct_tasks/*.json
!/robot_sim/evaluation_tasks/*.json
!/robot_sim/models/yandex_rover/specification.json
.DS_Store
