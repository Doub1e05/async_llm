<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.9">
  <model name="turtlebot3_burger" canonical_link="base_link">
    <pose>-4 -2 0.078 0 0 0</pose>
    <link name="base_link">
      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.003290625</ixx>
          <iyy>0.004973</iyy>
          <izz>0.006238625</izz>
          <ixy>0</ixy>
