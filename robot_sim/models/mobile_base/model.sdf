          <image>
            <width>320</width>
            <height>240</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>20</far>
          </clip>
          <camera_info_topic>/camera/camera_info</camera_info_topic>
        </camera>
      </sensor>
      <sensor name="body_contact" type="contact">
        <always_on>true</always_on>
        <update_rate>20</update_rate>
        <topic>/contacts</topic>
        <contact>
          <collision>body_collision</collision>
        </contact>
      </sensor>
    </link>
    <link name="left_wheel">
      <pose>0 0.095 -0.045 0 0 0</pose>
      <inertial>
