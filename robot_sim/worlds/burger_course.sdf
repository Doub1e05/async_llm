<?xml version="1.0"?>
<sdf version="1.9">
  <world name="burger_course">
    <physics name="fast" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <light name="sun" type="directional">
      <pose>0 0 8 0 0 0</pose>
      <direction>-0.4 0.2 -1</direction>
      <diffuse>0.9 0.9 0.9 1</diffuse>
    </light>
    <model name="ground">
      <static>true</static>
      <link name="surface">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>12 8</size></plane></geometry></collision>
        <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>12 8</size></plane></geometry><material><ambient>0.72 0.74 0.72 1</ambient><diffuse>0.72 0.74 0.72 1</diffuse></material></visual>
      </link>
    </model>

    <model name="wall_north"><static>true</static><pose>0 3.5 0.35 0 0 0</pose><link name="body"><collision name="c"><geometry><box><size>12 0.15 0.7</size></box></geometry></collision><visual name="v"><geometry><box><size>12 0.15 0.7</size></box></geometry></visual></link></model>
    <model name="wall_south"><static>true</static><pose>0 -3.5 0.35 0 0 0</pose><link name="body"><collision name="c"><geometry><box><size>12 0.15 0.7</size></box></geometry></collision><visual name="v"><geometry><box><size>12 0.15 0.7</size></box></geometry></visual></link></model>
    <model name="wall_east"><static>true</static><pose>5.9 0 0.35 0 0 0</pose><link name="body"><collision name="c"><geometry><box><size>0.15 7 0.7</size></box></geometry></collision><visual name="v"><geometry><box><size>0.15 7 0.7</size></box></geometry></visual></link></model>
    <model name="wall_west"><static>true</static><pose>-5.9 0 0.35 0 0 0</pose><link name="body"><collision name="c"><geometry><box><size>0.15 7 0.7</size></box></geometry></collision><visual name="v"><geometry><box><size>0.15 7 0.7</size></box></geometry></visual></link></model>

    <model name="obstacle_a"><static>true</static><pose>1.6 0.8 0.3 0 0 0</pose><link name="body"><collision name="c"><geometry><box><size>0.8 1.5 0.6</size></box></geometry></collision><visual name="v"><geometry><box><size>0.8 1.5 0.6</size></box></geometry><material><ambient>0.75 0.27 0.18 1</ambient><diffuse>0.75 0.27 0.18 1</diffuse></material></visual></link></model>
    <model name="obstacle_b"><static>true</static><pose>-1.4 -0.9 0.3 0 0 0</pose><link name="body"><collision name="c"><geometry><box><size>1.4 0.7 0.6</size></box></geometry></collision><visual name="v"><geometry><box><size>1.4 0.7 0.6</size></box></geometry><material><ambient>0.18 0.38 0.72 1</ambient><diffuse>0.18 0.38 0.72 1</diffuse></material></visual></link></model>

    <model name="turtlebot3_burger" canonical_link="base_link">
      <pose>-4.3 -2.3 0.12 0 0 0</pose>
      <link name="base_link">
        <inertial><mass>1.5</mass><inertia><ixx>0.006</ixx><iyy>0.006</iyy><izz>0.009</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <sensor name="lidar" type="gpu_lidar">
          <pose>0 0 0.08 0 0 0</pose><topic>/scan</topic><update_rate>10</update_rate><always_on>true</always_on>
          <gz_frame_id>base_link</gz_frame_id>
          <lidar><scan><horizontal><samples>360</samples><resolution>1</resolution><min_angle>-3.14159265</min_angle><max_angle>3.14159265</max_angle></horizontal></scan><range><min>0.06</min><max>10</max><resolution>0.01</resolution></range></lidar>
        </sensor>
        <collision name="body_collision"><geometry><box><size>0.178 0.135 0.09</size></box></geometry></collision>
        <visual name="body_visual"><geometry><box><size>0.178 0.135 0.09</size></box></geometry><material><ambient>0.12 0.14 0.16 1</ambient><diffuse>0.12 0.14 0.16 1</diffuse></material></visual>
      </link>
      <link name="left_wheel">
        <pose>0 0.095 -0.045 1.570796 0 0</pose><inertial><mass>0.05</mass><inertia><ixx>0.00002</ixx><iyy>0.00002</iyy><izz>0.00002</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="wheel_collision"><geometry><cylinder><radius>0.033</radius><length>0.018</length></cylinder></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="wheel_visual"><geometry><cylinder><radius>0.033</radius><length>0.018</length></cylinder></geometry><material><ambient>0.04 0.04 0.04 1</ambient><diffuse>0.04 0.04 0.04 1</diffuse></material></visual>
      </link>
      <link name="right_wheel">
        <pose>0 -0.095 -0.045 1.570796 0 0</pose><inertial><mass>0.05</mass><inertia><ixx>0.00002</ixx><iyy>0.00002</iyy><izz>0.00002</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="wheel_collision"><geometry><cylinder><radius>0.033</radius><length>0.018</length></cylinder></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="wheel_visual"><geometry><cylinder><radius>0.033</radius><length>0.018</length></cylinder></geometry><material><ambient>0.04 0.04 0.04 1</ambient><diffuse>0.04 0.04 0.04 1</diffuse></material></visual>
      </link>
      <link name="caster"><pose>-0.065 0 -0.07 0 0 0</pose><inertial><mass>0.02</mass><inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial><collision name="caster_collision"><geometry><sphere><radius>0.012</radius></sphere></geometry></collision><visual name="caster_visual"><geometry><sphere><radius>0.012</radius></sphere></geometry></visual></link>
      <joint name="left_wheel_joint" type="revolute"><parent>base_link</parent><child>left_wheel</child><axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis></joint>
      <joint name="right_wheel_joint" type="revolute"><parent>base_link</parent><child>right_wheel</child><axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis></joint>
      <joint name="caster_joint" type="fixed"><parent>base_link</parent><child>caster</child></joint>
      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint><right_joint>right_wheel_joint</right_joint>
        <wheel_separation>0.19</wheel_separation><wheel_radius>0.033</wheel_radius>
        <topic>/model/turtlebot3_burger/cmd_vel</topic><odom_topic>/model/turtlebot3_burger/odometry</odom_topic><frame_id>odom</frame_id><child_frame_id>base_link</child_frame_id>
        <odom_publish_frequency>20</odom_publish_frequency>
        <max_linear_velocity>0.22</max_linear_velocity><max_angular_velocity>2.84</max_angular_velocity><max_linear_acceleration>1.0</max_linear_acceleration><max_angular_acceleration>3.0</max_angular_acceleration>
      </plugin>
    </model>
  </world>
</sdf>
